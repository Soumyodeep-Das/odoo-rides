generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           String      @id @default(uuid())
  name         String
  address      String?
  industry     String?
  contactEmail String?
  contactPhone String?
  logoUrl      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  users        User[]
  settings     OrgSettings?
}

model OrgSettings {
  id                    String       @id @default(uuid())
  orgId                 String       @unique
  fuelCostPerLitre      Float        @default(90.0)
  costPerKm             Float        @default(4.5)
  travelAllowancePerKm  Float        @default(3.0)
  bookingCutoffMinutes  Int          @default(30)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  org                   Organization @relation(fields: [orgId], references: [id])
}

model User {
  id        String       @id @default(uuid())
  orgId     String
  role      Role         @default(EMPLOYEE)
  name      String
  email     String       @unique
  password  String?
  phone     String
  avatarUrl String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  bookings  Booking[]
  payouts   Payout[]
  rides     Ride[]
  org       Organization @relation(fields: [orgId], references: [id])
  vehicles  Vehicle[]
  wallet    Wallet?
}

model Vehicle {
  id        String   @id @default(uuid())
  userId    String
  carModel  String
  make      String
  color     String
  year      Int
  seats     Int
  status    VehicleStatus @default(APPROVED)
  regNo     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rides     Ride[]
  user      User     @relation(fields: [userId], references: [id])
}

model Ride {
  id             String     @id @default(uuid())
  driverId       String
  vehicleId      String
  pickup         String
  dropoff        String
  departure      DateTime
  totalSeats     Int
  availableSeats Int
  status         RideStatus @default(SCHEDULED)
  price          Decimal    @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  bookings       Booking[]
  driver         User       @relation(fields: [driverId], references: [id])
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id])
}

model Booking {
  id          String        @id @default(uuid())
  passengerId String
  rideId      String
  status      BookingStatus @default(CONFIRMED)
  seats       Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  passenger   User          @relation(fields: [passengerId], references: [id])
  ride        Ride          @relation(fields: [rideId], references: [id])
  payment     Payment?
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("INR")
  status    PaymentStatus @default(PENDING)
  method    PaymentMethod @default(WALLET)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  booking   Booking       @relation(fields: [bookingId], references: [id])
  payout    Payout?

  @@index([status])
  @@index([method])
}

model Payout {
  id          String       @id @default(uuid())
  paymentId   String       @unique
  driverId    String
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  driver      User         @relation(fields: [driverId], references: [id])
  payment     Payment      @relation(fields: [paymentId], references: [id])

  @@index([driverId])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id          String                @id @default(uuid())
  walletId    String
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  description String?
  referenceId String?
  createdAt   DateTime              @default(now())
  wallet      Wallet                @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([type])
}

enum RideStatus {
  SCHEDULED
  ACTIVE
  CANCELED
  COMPLETED
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum VehicleStatus {
    PENDING
    APPROVED
    REJECTED
    INACTIVE
}

enum PaymentMethod {
  WALLET
  CASH
  CARD
  UPI
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}
