generator client {
    provider = "prisma-client"
}

datasource db {
    provider = "postgresql"
}

model Organization {
    id        String   @id @default(uuid())
    name      String
    users     User[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model User {
    id        String       @id @default(uuid())
    org       Organization @relation(fields: [orgId], references: [id])
    orgId     String
    role      Role         @default(EMPLOYEE)
    name      String
    email     String       @unique
    password  String
    phone     String
    vehicles  Vehicle[]
    rides     Ride[]
    bookings  Booking[]
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt
}

model Vehicle {
    id        String   @id @default(uuid())
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    carModel  String
    make      String
    color     String
    seats     Int
    regNo     String   @unique
    rides     Ride[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Ride {
    id         String     @id @default(uuid())
    driverId   String
    driver     User       @relation(fields: [driverId], references: [id])
    vehicleId  String
    vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])
    pickup     String
    dropoff    String
    departure  DateTime
    totalSeats Int
    status     RideStatus @default(SCHEDULED)
    bookings   Booking[]
    price      Decimal    @db.Decimal(10, 2)
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
}

model Booking {
    id          String @id @default(uuid())
    passengerId String
    passenger   User   @relation(fields: [passengerId], references: [id])
    rideId      String
    ride        Ride   @relation(fields: [rideId], references: [id])
}

enum RideStatus {
    SCHEDULED
    ACTIVE
    CANCELED
    COMPLETED
}

enum Role {
    ADMIN
    EMPLOYEE
}
